name: CI

# A deliberately minimal starting point: install, then `npm test`. It assumes an npm
# project and nothing else. Adjust it to whatever this repo actually needs to build
# and test; this is a starting point, not a fixed contract.
on:
  push:
    branches: [{{#if gitflow}}main, develop{{else}}main{{/if}}]
  pull_request:
    branches: [{{#if gitflow}}main, develop{{else}}main{{/if}}]

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-node@v5
        with:
          node-version: 22
      - run: npm ci
      - run: npm test
