name: PR description

# Separate from ci.yml on purpose. This needs the `edited` event so that fixing a
# description re-runs the check; and `edited` on ci.yml would re-run typecheck, both
# gate suites and two production builds every time someone touches a sentence.
on:
  pull_request:
    types: [opened, edited, reopened, synchronize, ready_for_review]

concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  template:
    name: description follows the template
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-node@v5
        with:
          node-version: 22
          # setup-node reads `packageManager` from package.json and tries to warm a
          # pnpm cache. This job installs nothing, and pnpm is not on the runner, so
          # the default would fail the job before the gate ever runs.
          package-manager-cache: false

      # The gate's own negative tests, proving it fails on a violation rather than
      # passing everything. No install step: the script is dependency-free.
        # Globbed rather than `node --test scripts/`: the directory form resolves the
        # path as a module on some Node versions and dies with MODULE_NOT_FOUND.
      - name: Test the gate
        run: node --test scripts/*.test.mjs

      - name: Check this PR's description
        # Passed through the environment, never interpolated into the shell. A PR body
        # is attacker-controlled text; `${{ … }}` inside a run block would make it
        # executable.
        env:
          PR_BODY: ${{ github.event.pull_request.body }}
        run: node scripts/check-pr-description.mjs
